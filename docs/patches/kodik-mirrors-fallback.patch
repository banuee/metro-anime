+    private suspend fun fetchAnimeOnDubs(shikimoriId: Long?, titleQuery: String?): List<DubbingGroup> {
+        try {
+            val q = if (shikimoriId != null && shikimoriId > 0) shikimoriId.toString() else titleQuery?.trim() ?: return emptyList()
+            val encodedQuery = URLEncoder.encode(q, "UTF-8")
+            val searchUrl = "https://animeon.cc/api/search?q=$encodedQuery"
+            val req = Request.Builder()
+                .url(searchUrl)
+                .header("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36")
+                .build()
+            val searchBody = client.newCall(req).execute().use { resp ->
+                if (!resp.isSuccessful) return emptyList()
+                resp.body?.string() ?: return emptyList()
+            }
+            val searchRoot = gson.fromJson(searchBody, JsonObject::class.java)
+            val results = searchRoot.getAsJsonArray("results") ?: return emptyList()
+            if (results.size() == 0) return emptyList()
+
+            var matchedUrl: String? = null
+            if (shikimoriId != null && shikimoriId > 0) {
+                val sIdStr = shikimoriId.toString()
+                for (elem in results) {
+                    val obj = elem.asJsonObject
+                    if (obj.get("shikimori_id")?.takeIf { !it.isJsonNull }?.asString == sIdStr) {
+                        matchedUrl = obj.get("anime_url")?.takeIf { !it.isJsonNull }?.asString
+                        break
+                    }
+                }
+            }
+            if (matchedUrl == null && results.size() > 0) {
+                matchedUrl = results[0].asJsonObject.get("anime_url")?.takeIf { !it.isJsonNull }?.asString
+            }
+            if (matchedUrl.isNullOrBlank()) return emptyList()
+
+            val detailUrl = "https://animeon.cc/api/anime/$matchedUrl"
+            val detailReq = Request.Builder()
+                .url(detailUrl)
+                .header("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36")
+                .build()
+            val detailBody = client.newCall(detailReq).execute().use { resp ->
+                if (!resp.isSuccessful) return emptyList()
+                resp.body?.string() ?: return emptyList()
+            }
+            val detailRoot = gson.fromJson(detailBody, JsonObject::class.java)
+            val translations = detailRoot.getAsJsonObject("translations") ?: return emptyList()
+
+            val dubGroups = mutableListOf<DubbingGroup>()
+            for (rawDubName in translations.keySet()) {
+                val dubObj = translations.getAsJsonObject(rawDubName) ?: continue
+                val dubTitle = rawDubName.replace("_", " ").trim()
+                val episodesList = mutableListOf<AnimeEpisode>()
+                val epObj = dubObj.getAsJsonObject("episodes")
+
+                if (epObj != null) {
+                    for (epKey in epObj.keySet()) {
+                        val epElem = epObj.get(epKey) ?: continue
+                        val ord = epKey.toIntOrNull() ?: 1
+                        var link: String? = null
+                        var preview: String? = null
+                        if (epElem.isJsonObject) {
+                            val o = epElem.asJsonObject
+                            link = o.get("link")?.takeIf { !it.isJsonNull }?.asString
+                            val screens = o.getAsJsonArray("screenshots")
+                            preview = screens?.firstOrNull()?.takeIf { !it.isJsonNull }?.asString?.let {
+                                if (it.startsWith("//")) "https:$it" else it
+                            }
+                        } else if (epElem.isJsonPrimitive) {
+                            link = epElem.asString
+                        }
+                        if (link.isNullOrBlank()) continue
+                        val fullUrl = if (link.startsWith("//")) "https:$link" else link
+                        episodesList.add(
+                            AnimeEpisode(
+                                ordinal = ord,
+                                name = "Серия $ord",
+                                hlsStreams = mapOf("embed" to fullUrl),
+                                previewUrl = preview,
+                            )
+                        )
+                    }
+                } else {
+                    val singleLink = dubObj.get("link")?.takeIf { !it.isJsonNull }?.asString
+                    if (!singleLink.isNullOrBlank()) {
+                        val fullUrl = if (singleLink.startsWith("//")) "https:$singleLink" else singleLink
+                        episodesList.add(
+                            AnimeEpisode(
+                                ordinal = 1,
+                                name = "Фильм / Серия 1",
+                                hlsStreams = mapOf("embed" to fullUrl),
+                            )
+                        )
+                    }
+                }
+
+                if (episodesList.isNotEmpty()) {
+                    episodesList.sortBy { it.ordinal }
+                    dubGroups.add(
+                        DubbingGroup(
+                            id = "kodik_animeon_${rawDubName.lowercase()}",
+                            title = dubTitle,
+                            source = AnimeSource.KODIK,
+                            episodes = episodesList,
+                        )
+                    )
+                }
+            }
+            return dubGroups
+        } catch (e: Exception) {
+            Log.w(TAG, "AnimeOn dub fetch error", e)
+            return emptyList()
+        }
+    }
