+    private suspend fun fetchYummyDubs(shikimoriId: Long?, titleQuery: String?): List<DubbingGroup> {
+        try {
+            val q = titleQuery?.trim() ?: shikimoriId?.toString() ?: return emptyList()
+            val encodedQuery = URLEncoder.encode(q, "UTF-8")
+            val searchUrl = "https://old.yummyani.me/api/search?q=$encodedQuery"
+            val req = Request.Builder()
+                .url(searchUrl)
+                .header("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36")
+                .build()
+            val searchBody = client.newCall(req).execute().use { resp ->
+                if (!resp.isSuccessful) return emptyList()
+                resp.body?.string() ?: return emptyList()
+            }
+            val searchRoot = gson.fromJson(searchBody, JsonObject::class.java)
+            val items = searchRoot.getAsJsonArray("response") ?: return emptyList()
+            if (items.size() == 0) return emptyList()
+
+            var matchedAnimeId: Int? = null
+            if (shikimoriId != null && shikimoriId > 0) {
+                for (elem in items) {
+                    val o = elem.asJsonObject
+                    val rIds = o.getAsJsonObject("remote_ids")
+                    if (rIds?.get("shikimori_id")?.takeIf { !it.isJsonNull }?.asLong == shikimoriId) {
+                        matchedAnimeId = o.get("anime_id")?.takeIf { !it.isJsonNull }?.asInt
+                        break
+                    }
+                }
+            }
+            if (matchedAnimeId == null && items.size() > 0) {
+                matchedAnimeId = items[0].asJsonObject.get("anime_id")?.takeIf { !it.isJsonNull }?.asInt
+            }
+            if (matchedAnimeId == null) return emptyList()
+
+            val videosUrl = "https://old.yummyani.me/api/anime/$matchedAnimeId/videos"
+            val videosReq = Request.Builder()
+                .url(videosUrl)
+                .header("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36")
+                .build()
+            val videosBody = client.newCall(videosReq).execute().use { resp ->
+                if (!resp.isSuccessful) return emptyList()
+                resp.body?.string() ?: return emptyList()
+            }
+            val videosRoot = gson.fromJson(videosBody, JsonObject::class.java)
+            val videoItems = videosRoot.getAsJsonArray("response") ?: return emptyList()
+
+            val byDubbing = mutableMapOf<String, MutableList<AnimeEpisode>>()
+            for (vElem in videoItems) {
+                val vObj = vElem.asJsonObject
+                val dataObj = vObj.getAsJsonObject("data")
+                val player = dataObj?.get("player")?.takeIf { !it.isJsonNull }?.asString.orEmpty()
+                val iframeUrl = vObj.get("iframe_url")?.takeIf { !it.isJsonNull }?.asString.orEmpty()
+                if (!player.contains("Kodik", ignoreCase = true) && !iframeUrl.contains("kodik", ignoreCase = true)) {
+                    continue
+                }
+                var dubName = dataObj?.get("dubbing")?.takeIf { !it.isJsonNull }?.asString.orEmpty().ifBlank { "Kodik" }
+                dubName = dubName.removePrefix("Озвучка ").trim()
+                val numStr = vObj.get("number")?.takeIf { !it.isJsonNull }?.asString ?: "1"
+                val ord = numStr.toIntOrNull() ?: 1
+                val fullUrl = if (iframeUrl.startsWith("//")) "https:$iframeUrl" else iframeUrl
+
+                val list = byDubbing.getOrPut(dubName) { mutableListOf() }
+                list.add(
+                    AnimeEpisode(
+                        ordinal = ord,
+                        name = "Серия $ord",
+                        hlsStreams = mapOf("embed" to fullUrl),
+                    )
+                )
+            }
+
+            return byDubbing.map { (dubName, eps) ->
+                val sorted = eps.distinctBy { it.ordinal }.sortedBy { it.ordinal }
+                DubbingGroup(
+                    id = "kodik_yummy_${dubName.lowercase()}",
+                    title = dubName,
+                    source = AnimeSource.KODIK,
+                    episodes = sorted,
+                )
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "Yummy dub fetch error", e)
+            return emptyList()
+        }
+    }
