+                if (list.size >= limit) break
+                val obj = elem.asJsonObject
+                val titleRu = obj.get("title")?.takeIf { !it.isJsonNull }?.asString?.trim() ?: continue
+                val titleOrig = obj.get("title_orig")?.takeIf { !it.isJsonNull }?.asString?.trim()
