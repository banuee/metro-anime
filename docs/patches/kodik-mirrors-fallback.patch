+
+                val poster = if (shikiId != null && shikiId > 0) {
+                    "https://shikimori.one/system/animes/original/$shikiId.jpg"
+                } else if (!rawPoster.isNullOrBlank()) {
+                    if (rawPoster.startsWith("//")) "https:$rawPoster"
+                    else if (rawPoster.startsWith("/")) "https://animeon.cc$rawPoster"
+                    else rawPoster
+                } else ""
+
+                val year = obj.get("year")?.takeIf { !it.isJsonNull }?.asInt
+                    ?: matData?.get("year")?.takeIf { !it.isJsonNull }?.asInt
+
+                val kind = obj.get("kind")?.takeIf { !it.isJsonNull }?.asString
+                val type = when (kind?.lowercase()) {
+                    "tv" -> "Сериал"
+                    "movie" -> "Фильм"
+                    else -> kind
+                }
+
+                val epsCount = matData?.get("episodes_aired")?.takeIf { !it.isJsonNull }?.asInt
+                    ?: matData?.get("episodes_total")?.takeIf { !it.isJsonNull }?.asInt
+
+                val rating = matData?.get("shikimori_rating")?.takeIf { !it.isJsonNull }?.asDouble
+                    ?: obj.get("rating")?.takeIf { !it.isJsonNull }?.asDouble
+
+                val genresList = mutableListOf<String>()
+                matData?.getAsJsonArray("anime_genres")?.forEach { g ->
+                    if (g.isJsonPrimitive) genresList.add(g.asString)
+                }
+
+                val animeId = if (shikiId != null && shikiId > 0) "kodik_shiki_$shikiId" else "kodik_animeon_$animeUrl"
+
+                list.add(
+                    AnimeTitle(
+                        id = animeId,
+                        titleRu = titleRu,
+                        titleOrig = titleOrig,
+                        posterUrl = poster,
+                        description = null,
+                        year = year,
+                        type = type,
+                        episodesCount = epsCount,
+                        genres = genresList,
+                        rating = rating,
+                        shikimoriId = shikiId,
+                        source = AnimeSource.KODIK,
